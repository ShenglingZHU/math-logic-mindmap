  "theorem": {
    "title": "Two-variable arithmetic-geometric mean inequality",
    "statement_latex": "\\forall a,b\\in[0,\\infty),\\quad\\frac{a+b}{2}\\ge\\sqrt{ab}",
    "assumptions": [
      "$a,b$ are nonnegative real numbers."
    ],
    "proof_standard": "strict",
    "status": "proved"
  },
  "context": {
